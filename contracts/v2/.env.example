# ────────────────────────────────────────────────────────────────
# Trinity Network — Base Sepolia deployment template
# Copy to .env and fill in YOUR values BEFORE running ./deploy.sh
# DO NOT commit .env to git (already in .gitignore)
# ────────────────────────────────────────────────────────────────

# Base Sepolia RPC (public works; or use Alchemy/QuickNode for reliability)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Funded private key (need ~0.02 ETH on Base Sepolia)
# Get faucet at:
#   https://www.alchemy.com/faucets/base-sepolia
#   https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
PRIVATE_KEY=0xYOUR_FUNDED_PRIVATE_KEY_HERE

# Basescan API key for automatic verification
# Get at: https://basescan.org/myapikey
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Optional: pin sender address (must match PRIVATE_KEY)
# DEPLOYER=0xYOUR_ADDRESS
